@startuml Object_Diagram_Snapshot

object "user1: User" as User1 {
  id = "u-001"
  email = "alice@example.com"
  name = "Alice"
}

object "board1: Board" as Board1 {
  id = "b-001"
  title = "Sprint Planning"
  creatorId = "u-001"
}

object "member1: BoardMember" as BM1 {
  id = "bm-001"
  userId = "u-001"
  boardId = "b-001"
  role = ADMIN
}

object "member2: BoardMember" as BM2 {
  id = "bm-002"
  userId = "u-002"
  boardId = "b-001"
  role = EDITOR
}

object "user2: User" as User2 {
  id = "u-002"
  email = "bob@example.com"
  name = "Bob"
}

object "shape1: Shape" as Shape1 {
  id = "s-001"
  boardId = "b-001"
  userId = "u-001"
  type = RECTANGLE
  data = { x:100, y:50, w:200, h:150 }
}

object "shape2: Shape" as Shape2 {
  id = "s-002"
  boardId = "b-001"
  userId = "u-002"
  type = TEXT
  data = { x:120, y:70, text:"Q1 Goals" }
}

object "comment1: Comment" as Comment1 {
  id = "c-001"
  boardId = "b-001"
  shapeId = "s-001"
  userId = "u-002"
  content = "Should we expand this?"
}

object "snapshot1: Snapshot" as Snap1 {
  id = "sn-001"
  boardId = "b-001"
  version = 5
}

User1 --> BM1 : has
User2 --> BM2 : has
Board1 --> BM1 : contains
Board1 --> BM2 : contains
Board1 --> Shape1 : contains
Board1 --> Shape2 : contains
Board1 --> Snap1 : has version
User1 --> Shape1 : drew
User2 --> Shape2 : drew
Shape1 --> Comment1 : receives
User2 --> Comment1 : wrote

@enduml
