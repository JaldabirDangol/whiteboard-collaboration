@startuml Activity_Diagram_Collaboration

start
:User opens application;
:User logs in / registers;

repeat
  :View dashboard;
  :Select or create board;

  if (Has access?) then (yes)
    :Join board;
    :Load Y.Doc from server;
    :Render canvas with existing shapes;
    :Connect Socket.IO;

    repeat
      fork
        :Draw / Edit shapes;
        :Yjs sync update;
        :Server broadcasts to all clients;
      fork again
        :Move cursor;
        :Server relays cursor position;
      fork again
        :Send chat message;
        :Server stores & broadcasts;
      fork again
        :Add shape comment;
        :Server stores & relays;
      end fork

      if (Undo / Redo requested?) then (yes)
        :Emit board:undo / board:redo;
        :Server restores snapshot;
        :Broadcast full board state;
      endif

      if (Snapshot requested?) then (yes)
        :Save current Y.Doc state;
        :Store snapshot in database;
      endif
    repeat while (Still editing?) is (yes)
    :Leave board;
  else (no)
    :Show access denied;
  endif

while (Continue using app?) is (yes)

:Logout;
stop

@enduml
