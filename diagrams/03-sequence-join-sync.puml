@startuml Sequence_Diagram_Join

actor "Client A" as ClientA
participant "Frontend\n(Next.js)" as Frontend
participant "Socket.IO\nServer" as SocketIO
participant "Auth\nMiddleware" as Auth
participant "Y.Doc\nStore" as YDoc
database "PostgreSQL\n(Database)" as DB

== Board Join Flow ==

ClientA -> Frontend: Open board page /boards/:slug
Frontend -> SocketIO: socket.connect()
SocketIO -> Auth: socketAuth middleware
Auth --> SocketIO: userId from JWT
SocketIO -> SocketIO: socket.join(boardId)
SocketIO -> SocketIO: socket.join("user:{userId}")

Frontend -> SocketIO: emit("board:join", { boardId })
SocketIO -> YDoc: getYDoc(boardId)
alt Y.Doc not in memory
  YDoc -> DB: fetch latest shapes
  DB --> YDoc: shape records
  YDoc -> YDoc: create Y.Doc + apply shapes
else Y.Doc in memory
  YDoc --> YDoc: return existing Y.Doc
end

SocketIO --> Frontend: emit("board:init", encodedState)
Frontend -> Frontend: Y.applyUpdate(doc, state)
Frontend -> Frontend: syncShapesFromYDoc() → render

SocketIO -> SocketIO: broadcast("board:userJoined", { userId })
SocketIO -> SocketIO: broadcast("presence:state", onlineUserIds)

== Yjs Sync Flow ==

Frontend -> Frontend: User draws shape (pointer events)
Frontend -> YDoc: doc.getMap("board").set("shape:uuid", json)
Frontend -> Frontend: Y.encodeStateAsUpdate(doc)
Frontend -> SocketIO: emit("yjs:update", { boardId, update })
SocketIO -> YDoc: Y.applyUpdate(doc, update)
SocketIO --> Other Clients: broadcast("yjs:update", update)
Other Clients -> Other Clients: Y.applyUpdate(localDoc, update)
Other Clients -> Other Clients: syncShapesFromYDoc() → render

SocketIO -> SocketIO: debounced persist (500ms)
SocketIO -> DB: replaceBoardShapes()
SocketIO -> DB: saveBoardSnapshot() [every 5th persist]

@enduml
