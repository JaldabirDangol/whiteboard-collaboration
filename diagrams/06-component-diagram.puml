@startuml Component_Diagram

!define LAYER skinparam backgroundColor #FEFEFE

LAYER

package "Frontend (Next.js 16)" {
  [Next.js App Router] as NextJS
  [React Konva Canvas] as Canvas
  [Zustand Stores] as Zustand
  [React Query] as RQ
  [Socket.IO Client] as SocketClient
  [Yjs Client] as YjsClient
  [shadcn/ui Components] as UI

  NextJS --> Canvas : renders
  NextJS --> UI : renders
  Canvas --> Zustand : tool/color state
  NextJS --> RQ : API queries
  RQ --> SocketClient : fallback
  Canvas --> YjsClient : CRDT sync
  YjsClient --> SocketClient : transport
  Canvas --> Zustand : cursor/selection
}

package "Backend (Express 5 + Socket.IO)" {
  [REST Controllers] as REST
  [Socket Event Handlers] as SocketEvents
  [Board Events] as BoardEvents
  [Presence Events] as PresenceEvents
  [Chat Events] as ChatEvents
  [Comment Events] as CommentEvents
  [Auth Middleware] as AuthMid
  [Rate Limiter] as RateLimiter
  [Yjs Server] as YjsServer
  [Board Services] as BoardSvc

  REST --> AuthMid : JWT validation
  REST --> BoardSvc : CRUD operations
  SocketEvents --> AuthMid : socketAuth
  SocketEvents --> RateLimiter : per-event throttle
  BoardEvents --> YjsServer : Y.Doc operations
  BoardEvents --> BoardSvc : shape persistence
  PresenceEvents --> SocketEvents : cursor relay
}

database "PostgreSQL" as PG {
  [Prisma ORM] as Prisma
  [Tables:\nUser, Board, BoardMember,\nShape, Snapshot, Comment,\nMessage, Asset, AuditLog,\nNotification, BoardSettings] as Tables
}

node "Docker Container" as Docker {
  PG
}

' --- Connections ---

NextJS --> REST : HTTP/REST (api.ts)
NextJS --> SocketEvents : WebSocket (socket.io)

SocketClient --> YjsServer : yjs:update
SocketClient --> BoardEvents : board:join/leave/undo/redo
SocketClient --> PresenceEvents : presence:cursorMove
SocketClient --> ChatEvents : chat relay
SocketClient --> CommentEvents : comment relay

BoardSvc --> Prisma : queries
REST --> Prisma : queries
Prisma --> Tables : SQL

@enduml
