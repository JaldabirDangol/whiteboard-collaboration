@startuml Use_Case_Diagram

left to right direction
skinparam packageStyle rectangle

actor "User\n(Admin/Editor/Viewer)" as User
actor "Admin" as Admin
actor "System" as System

rectangle "Whiteboard System" {
  usecase "UC1: Draw Shapes" as UC1
  usecase "UC2: Select/Move Shapes" as UC2
  usecase "UC3: Erase Shapes" as UC3
  usecase "UC4: Undo/Redo" as UC4
  usecase "UC5: Pan & Zoom Canvas" as UC5
  usecase "UC6: Chat in Board" as UC6
  usecase "UC7: Comment on Shapes" as UC7
  usecase "UC8: Share Board" as UC8
  usecase "UC9: Manage Members" as UC9
  usecase "UC10: View Activity Feed" as UC10
  usecase "UC11: Restore Snapshot" as UC11
  usecase "UC12: Export Board" as UC12
  usecase "UC13: Authenticate" as UC13
  usecase "UC14: Real-time Sync" as UC14
  usecase "UC15: Follow User" as UC15
  usecase "UC16: Accept/Decline Invite" as UC16
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC10
User --> UC12
User --> UC15
User --> UC16

Admin --> UC8
Admin --> UC9
Admin --> UC11

System --> UC13
System --> UC14

note right of UC1
  Sub-types: Pen, Line, Arrow,
  Rectangle, Circle, Ellipse, Text
end note

note bottom of UC14
  Yjs CRDT + Socket.IO
  - cursor positions
  - shape updates
  - presence status
end note

@enduml
