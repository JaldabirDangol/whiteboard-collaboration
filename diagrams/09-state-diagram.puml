@startuml State_Diagram_BoardShape

state "Shape Lifecycle" as ShapeLifecycle {
  [*] --> Draft : User starts drawing
  Draft --> Committed : Pointer up / finalize
  Draft --> Deleted : User cancels (Escape)
  Committed --> Selected : User clicks shape
  Selected --> Moving : User drags
  Moving --> Committed : Drop / pointer up
  Selected --> Resizing : Drag corner handle
  Resizing --> Committed : Drop / pointer up
  Committed --> Deleted : User deletes / eraser
  Deleted --> [*]
}

state "Board Connection States" as BoardStates {
  [*] --> Disconnected
  Disconnected --> Connecting : socket.connect()
  Connecting --> Connected : board:init received
  Connecting --> Error : timeout / auth failure
  Connected --> Disconnected : socket disconnect
  Error --> Connecting : reconnect attempt
}

state "Y.Doc Sync State" as YDocStates {
  [*] --> Syncing : board:join
  Syncing --> Synced : board:init (full state)
  Synced --> PendingLocalChange : user edits shape
  PendingLocalChange --> Synced : yjs:update sent to server
  Synced --> PendingRemoteChange : yjs:update received
  PendingRemoteChange --> Synced : Y.applyUpdate merged
  Synced --> Syncing : server requests full sync
}

@enduml
